# ==============================================================================
# Platform Environment Configuration
# ==============================================================================

# Application environment (development | production | testing)
APP_ENV=development
APP_URL=http://localhost:8080
PORT=8080

# Secret entry code for teaser/hidden login access (validated server-side)
ENTRY_CODE=anticipation2026

# Backend session & security secrets (generate secure random strings in production)
SESSION_SECRET=dev_session_secret_change_in_production_32bytes_min
INTERNAL_BIGSTORE_SECRET=dev_bigstore_secret_change_in_production_32bytes_min

# BigStore internal service configuration
BIGSTORE_URL=http://bigstore:8080
BIGSTORE_PORT=8080

# Movie metadata provider configuration
MOVIE_METADATA_PROVIDER=tmdb
TMDB_API_KEY=

# Storage settings
# 50 GiB = 53687091200 bytes
DEFAULT_STORAGE_QUOTA_BYTES=53687091200
# 5 GiB max upload size
MAX_UPLOAD_SIZE=5368709120

# SQLite database file paths within containers
SQLITE_BACKEND_PATH=/data/backend.sqlite
SQLITE_BIGSTORE_PATH=/data/databases/bigstore.sqlite
BIGSTORE_STORAGE_ROOT=/data/files
