{
  "name": "platform/backend",
  "description": "Platform core API backend service",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "migrate": "php bin/migrate.php",
    "test": "php tests/run_tests.php"
  }
}
